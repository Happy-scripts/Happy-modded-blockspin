local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local bGui = getPlayerESP(player)
			if bGui then
				local nameLabel = bGui:FindFirstChild("NameLabel")
				if nameLabel then nameLabel.Visible = viewNamesEnabled end

				local healthBg = bGui:FindFirstChild("HealthBg")
				if healthBg then
					healthBg.Visible = viewHealthEnabled
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
						local healthFill = healthBg:FindFirstChild("HealthFill")
						if healthFill then
							healthFill.Size = UDim2.new(healthRatio, 0, 1, 0)
							healthFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthRatio), 255 * healthRatio, 0)
						end
					end
				end
			end
		end
	end
end

----------------------------------------------------
-- AIMBOT INSTANTÁNEO Y BUCLE RUNSERVICE
----------------------------------------------------
local function isValidTarget(part)
	if not part or not part.Parent then return false end
	local humanoid = part.Parent:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end

	local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen then return false end
	
	if fovEnabled then
		local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
		local distance = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
		if distance > fovRadius then return false end
	end

	return true
end

local function getClosestTarget()
	if isValidTarget(currentTarget) then return currentTarget end

	local closestPart = nil
	local shortestDistance = fovEnabled and fovRadius or math.huge
	local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				local targetPart = player.Character:FindFirstChild("Head") 
					or player.Character:FindFirstChild("UpperTorso") 
					or player.Character:FindFirstChild("Torso")

				if targetPart then
					local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
					if onScreen then
						local distance = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
						if distance <= shortestDistance then
							shortestDistance = distance
							closestPart = targetPart
						end
					end
				end
			end
		end
	end
	return closestPart
end

RunService.RenderStepped:Connect(function()
	updateESP()
	
	if aimbotEnabled then
		currentTarget = getClosestTarget()
		if currentTarget then
			-- BLOQUEO INSTANTÁNEO ABSOLUTO (Sin Lerp)
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, currentTarget.Position)
		end
	else
		currentTarget = nil
	end
end)
