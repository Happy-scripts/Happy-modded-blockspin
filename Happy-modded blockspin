-- HITBOX EXPANDER (AZUL TRANSPARENTE + REGISTRO DE BALAS)
----------------------------------------------------
local function applyHitboxToPlayer(plr)
	if plr == LocalPlayer or not plr.Character then return end
	
	local targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
	
	if targetPart then
		if hitboxEnabled then
			targetPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
			targetPart.Transparency = 0.7
			targetPart.Color = Color3.fromRGB(0, 170, 255)
			targetPart.Material = Enum.Material.SmoothPlastic
			
			targetPart.CanCollide = false
			targetPart.CanTouch = true
			targetPart.CanQuery = true
		else
			targetPart.Size = Vector3.new(2, 2, 1)
			targetPart.Transparency = 1
			targetPart.CanCollide = false
		end
	end
end

HitboxBtn.MouseButton1Click:Connect(function()
	hitboxEnabled = not hitboxEnabled
	HitboxBtn.Text = "Hitbox Expander 📦: " .. (hitboxEnabled and "ON" or "OFF")
	HitboxBtn.TextColor3 = hitboxEnabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
	
	for _, plr in ipairs(Players:GetPlayers()) do
		applyHitboxToPlayer(plr)
	end
end)

