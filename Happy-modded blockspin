local v_u_3 = Net

task.wait(0.05)
local v_u_20 = v_u_3.send
local v_u_21 = v_u_3.send.FireServer
local v_u_4 = { event = 0, func = 0 }

function v_u_1.send(name, ...)
    v_u_4.event += 1
    v_u_21(v_u_20, v_u_4.event, name, ...)
end

local v_u_23 = v_u_3.get
local v_u_24 = v_u_3.get.InvokeServer
function v_u_1.get(name, ...)
    v_u_4.func += 1
    return v_u_24(v_u_23, v_u_4.func, name, ...)
end

local function v_u_29()
    v_u_3.send.OnClientEvent:Connect(function(name, ...)
        if v_u_5[name] then v_u_5[name](...) end
    end)
    function v_u_3.get.OnClientInvoke(name, ...)
        if v_u_5[name] then return v_u_5[name](...) end
        error("Invalid hook: "..name)
    end
    pcall(function()
        for i = 1, #v_u_7 do v_u_7[i]() end
    end)
end

function v_u_1.loaded()
    function v_u_3.get.OnClientInvoke(name)
        if name == "connect" then
            v_u_6 = true
            v_u_29()
            return true
        end
    end
    v_u_1.hook("ping", function() return true end)
end

