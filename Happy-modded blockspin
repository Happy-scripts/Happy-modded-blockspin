local v_u_1 = {}
local v_u_5 = {}
local v_u_6 = false
local v_u_7 = {}

function v_u_1.on_connect(p8)
    if v_u_6 then p8() else v_u_7[#v_u_7 + 1] = p8 end
end

function v_u_1.hook(name, func)
    if not func then error("Function nil for hook "..name) end
    if v_u_6 then
        if v_u_5[name] then warn("Overwriting hook: "..name) end
        v_u_5[name] = func
    else
        v_u_1.on_connect(function() v_u_1.hook(name, func) end)
    end
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
