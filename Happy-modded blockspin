-- Spin
local spinOn, spinAngle = false, 0
local function doSpin(dt)
    if not spinOn then return end
    spinAngle += 0.65 * 60 * dt
    spinAngle %= math.pi*2
    if RootPart then
        RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, spinAngle, 0)
        if Humanoid then Humanoid.AutoRotate = false end
    end
end
