-- Velocidad
local velocidad = 35, velActiva = false
Main:Toggle({Title = "Caminar Rápido", Flag = "vel", Value = false, Callback = function(v)
    velActiva = v
    if not v and Humanoid then Humanoid.WalkSpeed = 16 end
end})
Main:Slider({Title = "Velocidad", Flag = "val_vel", Min = 8, Max = 45, Default = 35, Callback = function(v)
    velocidad = v
end})
loop(0.2, function()
    if velActiva and Humanoid then
        pcall(function() Net.send("set_sprinting_1", true) end)
        Humanoid.WalkSpeed = velocidad
    end
end)

-- Salto Alto
local saltoAct = false
Main:Toggle({Title = "Salto Alto", Flag = "salto", Callback = function(v) saltoAct = v end})
UIS.JumpRequest:Connect(function()
    if saltoAct and RootPart then
        local v = RootPart.AssemblyLinearVelocity
        RootPart.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z)
    end
end)

-- Girar
local girarAct = false, angulo = 0
RunService.RenderStepped:Connect(function(dt)
    if not girarAct or not RootPart then return end
    angulo += 0.7 * 60 * dt
    angulo %= math.pi*2
    RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, angulo, 0)
    if Humanoid then Humanoid.AutoRotate = false end
end)
Main:Toggle({Title = "Girar Sin Parar", Flag = "girar", Callback = function(v)
    girarAct = v
    if not v then angulo = 0 if Humanoid then Humanoid.AutoRotate = true end end
end})

