local function permanentLoop(interval, fn)
    task.spawn(function()
        local waitTime = interval or 0.25
        while true do
            local ok = pcall(fn)
            task.wait(ok and waitTime or math.max(waitTime, 0.35))
        end
    end)
end

local function safeLoadUrl(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res then
        local ok2, fn = pcall(loadstring, res)
        if ok2 and fn then return fn() end
    end
    return nil
end

