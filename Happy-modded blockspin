local function loop(tiempo, fn)
    task.spawn(function()
        while task.wait(tiempo) do
            pcall(fn)
        end
    end
end

local function getHand()
    local lbl = PlayerGui:FindFirstChild("TopRightHud", true)
    if not lbl then return 0 end
    local txt = lbl.Holder.Frame.MoneyTextLabel.Text
    return tonumber(txt:match("%d+")) or 0
end

local function getBank()
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text:find("Bank Balance") then
            return tonumber(d.Text:match("%d+")) or 0
        end
    end
    return 0
end

