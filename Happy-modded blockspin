        dragging = true dragStart = input.Position startPos = ImageButton.Position hasDragged = false totalDistance = 0
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        totalDistance = math.abs(delta.X) + math.abs(delta.Y)
        if totalDistance > 5 then hasDragged = true end
        ImageButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if dragging then
            dragging = false
            if not hasDragged or totalDistance <= 5 then
                isOpen = not isOpen
                if isOpen then _G.Window:Open() else _G.Window:Close() end
            end
        end
    end
end)
