local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Main = Instance.new("Frame", ScreenGui)
Main.Size, Main.Position = UDim2.new(0, 150, 0, 180), UDim2.new(0.5, -75, 0.5, -90)
Main.BackgroundColor3, Main.Active, Main.Draggable = Color3.fromRGB(30, 30, 30), true, true

local UIList = Instance.new("UIListLayout", Main)
UIList.Padding, UIList.SortOrder = UDim2.new(0, 5), Enum.SortOrder.LayoutOrder

local function createBtn(text, callback)
    local btn = Instance.new("TextButton", Main)
    btn.Size, btn.Text = UDim2.new(1, 0, 0, 30), text
    btn.BackgroundColor3, btn.TextColor3 = Color3.fromRGB(50, 50, 50), Color3.fromRGB(255, 255, 255)
    btn.MouseButton1Click:Connect(callback)
end

-- Botones
createBtn("Hitbox: 10", function()
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            v.Character.HumanoidRootPart.Size = Vector3.new(10, 10, 10)
            v.Character.HumanoidRootPart.Transparency = 0.5
        end
    end
end)

createBtn("Hitbox: Reset", function()
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            v.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
            v.Character.HumanoidRootPart.Transparency = 1
        end
    end
end)

createBtn("Cerrar GUI", function() ScreenGui:Destroy() end)
