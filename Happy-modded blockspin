local function permanentLoop(interval, fn)
    task.spawn(function()
        local waitTime = interval or 0.25
        while true do
            local ok = pcall(fn)
            if not ok then
                task.wait(math.max(waitTime, 0.35))
            else
                task.wait(waitTime)
            end
        end
    end)
end

local function safeLoadUrl(url)
    local ok, res = pcall(function()
        if game.HttpGet then return game:HttpGet(url) end
        return game:HttpGetAsync(url)
    end)
    if ok and res then
        local ok2, fn = pcall(loadstring, res)
        if ok2 and fn then
            local ok3, result = pcall(fn)
            if ok3 then return result end
        end
    end
    return nil
end

local function safeDrawingNew(className)
    local ok, obj = pcall(function()
        if Drawing and Drawing.new then return Drawing.new(className) end
    end)
    if ok then return obj end
    return nil
end

