local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			
			applyHitboxToPlayer(player)

			local bGui = getPlayerESP(player)
			if bGui then
				local nameLabel = bGui:FindFirstChild("NameLabel")
				if nameLabel then nameLabel.Visible = viewNamesEnabled end

				local isSuspicious = checkHackerStatus(player)
				local hackerLabel = bGui:FindFirstChild("HackerLabel")
				if hackerLabel then hackerLabel.Visible = isSuspicious end

				local healthBg = bGui:FindFirstChild("HealthBg")
				if healthBg then
					healthBg.Visible = viewHealthEnabled
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
						local healthFill = healthBg:FindFirstChild("HealthFill")
						if healthFill then
							healthFill.Size = UDim2.new(healthRatio, 0, 1, 0)
							healthFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthRatio), 255 * healthRatio, 0)
						end
					end
				end
			end
		end
	end
end

