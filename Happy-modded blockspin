-- Sliders
local draggingSlider = false
local function updateSlider(input)
	local sliderX = SliderLine.AbsolutePosition.X
	local sliderWidth = SliderLine.AbsoluteSize.X
	local percentage = math.clamp((input.Position.X - sliderX) / sliderWidth, 0, 1)
	SliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)
	fovRadius = math.floor(30 + (percentage * 270))
	FOVLabel.Text = "Tamaño FOV: " .. tostring(fovRadius)
	FOVCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
end

SliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true end
end)

local draggingHitSlider = false
local function updateHitSlider(input)
	local sliderX = HitSliderLine.AbsolutePosition.X
	local sliderWidth = HitSliderLine.AbsoluteSize.X
	local percentage = math.clamp((input.Position.X - sliderX) / sliderWidth, 0, 1)
	HitSliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)
	hitboxSize = math.floor(2 + (percentage * 58))
	HitboxLabel.Text = "Tamaño Hitbox: " .. tostring(hitboxSize)
end

HitSliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingHitSlider = true end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSlider = false
		draggingHitSlider = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		if draggingSlider then updateSlider(input) end
		if draggingHitSlider then updateHitSlider(input) end
	end
end)

