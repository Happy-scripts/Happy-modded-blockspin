local function getItemAssetId(item)
	if not item then return nil end
	if item:IsA("Tool") and item.TextureId ~= "" and item.TextureId ~= "rbxassetid://0" then
		return item.TextureId
	end
	for _, child in ipairs(item:GetChildren()) do
		if child:IsA("StringValue") and (child.Name == "Texture" or child.Name == "Icon" or child.Name == "Image") then
			if child.Value ~= "" then return child.Value end
		elseif child:IsA("Texture") or child:IsA("Decal") then
			if child.Texture ~= "" then return child.Texture end
		end
	end
	return nil
end

local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local bGui = getPlayerESP(player)
			if bGui then
				local nameLabel = bGui:FindFirstChild("NameLabel")
				if nameLabel then nameLabel.Visible = viewNamesEnabled end

				local healthBg = bGui:FindFirstChild("HealthBg")
				if healthBg then
					healthBg.Visible = viewHealthEnabled
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
						local healthFill = healthBg:FindFirstChild("HealthFill")
						if healthFill then
							healthFill.Size = UDim2.new(healthRatio, 0, 1, 0)
							healthFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthRatio), 255 * healthRatio, 0)
						end
					end
				end

				local itemsFrame = bGui:FindFirstChild("ItemsFrame")
				if itemsFrame then
					itemsFrame.Visible = viewItemsEnabled
					if viewItemsEnabled then
						for _, child in ipairs(itemsFrame:GetChildren()) do
							if not child:IsA("UIListLayout") then child:Destroy() end
						end

						local function displayTool(item)
							if not item:IsA("Tool") then return end
							local assetId = getItemAssetId(item)

							if assetId then
								local img = Instance.new("ImageLabel")
								img.Size = UDim2.new(0, 24, 0, 24)
								img.BackgroundTransparency = 1
								img.Image = assetId
								img.Parent = itemsFrame
							else
								local txt = Instance.new("TextLabel")
								txt.Size = UDim2.new(0, 0, 0, 18)
								txt.AutomaticSize = Enum.AutomaticSize.X
								txt.BackgroundTransparency = 1
								txt.Text = "[" .. item.Name .. "]"
								txt.TextColor3 = Color3.fromRGB(255, 255, 180)
								txt.TextStrokeTransparency = 0
								txt.TextSize = 11
								txt.Font = Enum.Font.SourceSansBold
								txt.Parent = itemsFrame
							end
						end

						if player:FindFirstChild("Backpack") then
							for _, tool in ipairs(player.Backpack:GetChildren()) do displayTool(tool) end
						end
						for _, tool in ipairs(player.Character:GetChildren()) do displayTool(tool) end
					end
				end
			end
		end
	end
end

----------------------------------------------------
-- AIMBOT MEJORADO Y ESTABLE
----------------------------------------------------
local function isValidTarget(part)
	if not part or not part.Parent then return false end
	local humanoid = part.Parent:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end

	local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen then return false end
	
	if fovEnabled then
		local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
		local distance = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
		if distance > fovRadius then return false end
	end

	return true
end

local function getClosestTarget()
	if isValidTarget(currentTarget) then return currentTarget end

	local closestPart = nil
	local shortestDistance = fovEnabled and fovRadius or math.huge
	local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				local targetPart = player.Character:FindFirstChild("Head") 
					or player.Character:FindFirstChild("UpperTorso") 
					or player.Character:FindFirstChild("Torso")

				if targetPart then
					local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
					if onScreen then
						local distance = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
						if distance <= shortestDistance then
							shortestDistance = distance
							closestPart = targetPart
						end
					end
				end
			end
		end
	end
	return closestPart
end

-- Bucle Principal
RunService.RenderStepped:Connect(function()
	updateESP()

	if speedBoostEnabled and LocalPlayer.Character then
		local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.WalkSpeed ~= boostSpeed then
			humanoid.WalkSpeed = boostSpeed
		end
	end
	
	if aimbotEnabled then
		currentTarget = getClosestTarget()
		if currentTarget then
			local targetCFrame = CFrame.new(Camera.CFrame.Position, currentTarget.Position)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.45)
		end
	else
		currentTarget = nil
	end
end)
