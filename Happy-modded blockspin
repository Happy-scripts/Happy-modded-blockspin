local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

_G.NebulaConfig = {
    SilentAim = true,
    TargetPart = "Head",
    Wallbang = true,
    SpeedHack = true,
    SpeedValue = 24,
    InfiniteJump = true,
    GreenESP_Enabled = true,
    GreenESP_Color = Color3.fromRGB(0, 255, 128)
}

local function GetTarget()
    local nearest = nil
    local shortestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pos = player.Character.HumanoidRootPart.Position
            local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(pos)
            if onScreen then
                local dist = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearest = player
                end
            end
        end
    end
    return nearest
end

UserInputService.JumpRequest:Connect(function()
    if _G.NebulaConfig.InfiniteJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

RunService.RenderStepped:Connect(function()
    if _G.NebulaConfig.SpeedHack and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = _G.NebulaConfig.SpeedValue
    end
end)
local data = {}

local function clearPlayer(player)
    if data[player] then
        if data[player].hl then data[player].hl:Destroy() end
        data[player] = nil
    end
end

local function ensurePlayer(player)
    if not data[player] then data[player] = {} end
    if player.Character and not player.Character:FindFirstChild("NebulaGreenHL") then
        local hl = Instance.new("Highlight")
        hl.Name = "NebulaGreenHL"
        hl.FillColor = _G.NebulaConfig.GreenESP_Color
        hl.OutlineColor = Color3.fromRGB(0, 0, 0)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Adornee = player.Character
        hl.Parent = player.Character
        data[player].hl = hl
    end
end

RunService.Heartbeat:Connect(function()
    if not _G.NebulaConfig.GreenESP_Enabled then
        for plr in pairs(data) do clearPlayer(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then ensurePlayer(plr) end
    end
end)

Players.PlayerRemoving:Connect(clearPlayer)

print("Nebula Hub cargado correctamente.")
