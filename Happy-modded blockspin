local SendRemote = game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Send")
local oldFire = hookfunction(SendRemote.FireServer, function(self, ...)
    local args = {...}
    if _G.SilentAimEnabled and args[2] == "shoot_gun" then
        local target = nil local short = math.huge
        for _, p in pairs(Plrs:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
                local d = (p.Character.HumanoidRootPart.Position - Root.Position).Magnitude
                if d < short then short = d target = p.Character.Head end
            end
        end
        if target then
            args[4] = CFrame.lookAt(Cam.CFrame.Position, target.Position)
            args[5] = {{{ Instance = target, Normal = Vector3.new(0,1,0), Position = target.Position, Material = Enum.Material.Plastic, Distance = short }}}
        end
    end
    return oldFire(self, unpack(args))
end)

