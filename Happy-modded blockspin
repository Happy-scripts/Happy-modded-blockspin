local updatePlayerList

updatePlayerList = function()
	for _, child in ipairs(PlayerListScroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	local yOffset = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -6, 0, 30)
			row.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
			row.Parent = PlayerListScroll

			local rCorner = Instance.new("UICorner")
			rCorner.CornerRadius = UDim.new(0, 4)
			rCorner.Parent = row

			local pLabel = Instance.new("TextLabel")
			pLabel.Size = UDim2.new(0.35, 0, 1, 0)
			pLabel.Position = UDim2.new(0.02, 0, 0, 0)
			pLabel.BackgroundTransparency = 1
			pLabel.Text = plr.Name
			pLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			pLabel.TextXAlignment = Enum.TextXAlignment.Left
			pLabel.TextSize = 11
			pLabel.Font = Enum.Font.SourceSansBold
			pLabel.Parent = row

			local vBtn = Instance.new("TextButton")
			vBtn.Size = UDim2.new(0.18, 0, 0.8, 0)
			vBtn.Position = UDim2.new(0.38, 0, 0.1, 0)
			vBtn.BackgroundColor3 = (spectatingPlayer == plr) and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(45, 45, 45)
			vBtn.Text = "Ver"
			vBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			vBtn.TextSize = 11
			vBtn.Font = Enum.Font.SourceSansBold
			vBtn.Parent = row

			local vCorner = Instance.new("UICorner")
			vCorner.CornerRadius = UDim.new(0, 4)
			vCorner.Parent = vBtn

			vBtn.MouseButton1Click:Connect(function()
				if spectatingPlayer == plr then
					spectatingPlayer = nil
					if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
						Camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
					end
				else
					spectatingPlayer = plr
					if plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then
						Camera.CameraSubject = plr.Character:FindFirstChildOfClass("Humanoid")
					end
				end
				updatePlayerList()
			end)

			local aBtn = Instance.new("TextButton")
			aBtn.Size = UDim2.new(0.18, 0, 0.8, 0)
			aBtn.Position = UDim2.new(0.58, 0, 0.1, 0)
			aBtn.BackgroundColor3 = aliasedPlayers[plr.UserId] and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(45, 45, 45)
			aBtn.Text = aliasedPlayers[plr.UserId] and "Aliado" or "Alear"
			aBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			aBtn.TextSize = 11
			aBtn.Font = Enum.Font.SourceSansBold
			aBtn.Parent = row

			local aCorner = Instance.new("UICorner")
			aCorner.CornerRadius = UDim.new(0, 4)
			aCorner.Parent = aBtn

			aBtn.MouseButton1Click:Connect(function()
				aliasedPlayers[plr.UserId] = not aliasedPlayers[plr.UserId]
				updatePlayerList()
			end)

			local isFixed = (fixedTarget == plr)
			local fBtn = Instance.new("TextButton")
			fBtn.Size = UDim2.new(0.2, 0, 0.8, 0)
			fBtn.Position = UDim2.new(0.78, 0, 0.1, 0)
			fBtn.BackgroundColor3 = isFixed and Color3.fromRGB(180, 0, 255) or Color3.fromRGB(45, 45, 45)
			fBtn.Text = isFixed and "Desfijar" or "Fijar"
			fBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			fBtn.TextSize = 11
			fBtn.Font = Enum.Font.SourceSansBold
			fBtn.Parent = row

			local fCorner = Instance.new("UICorner")
			fCorner.CornerRadius = UDim.new(0, 4)
			fCorner.Parent = fBtn

			fBtn.MouseButton1Click:Connect(function()
				if fixedTarget == plr then
					fixedTarget = nil
					if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
						Camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
					end
				else
					fixedTarget = plr
				end
				updatePlayerList()
			end)

			yOffset = yOffset + 34
		end
	end
	PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

