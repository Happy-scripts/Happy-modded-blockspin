-- NEBULA HUB | Block Spin (Parte 1 / 2)
if not game:IsLoaded() then
    repeat task.wait() until game:IsLoaded()
end

if not (game.PlaceId == 104715542330896 or game.PlaceId == 97556409405464) then
    return
end

local function LoadNebulaHubPart1()
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local TransitionModule = require(RS.Modules.Game.UI.TransitionUI)
        local old_transition = TransitionModule.transition
        TransitionModule.transition = function(p_in, p_wait, p_out, noLogo)
            if old_transition then
                return old_transition(p_in, p_wait, p_out, noLogo)
            end
        end
    end)

    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local CharCreator = require(RS.Modules.Game.CharacterCreator.CharacterCreator)
        if CharCreator.start then
            CharCreator.start = function(...)
                while true do task.wait(1) end
            end
        end
    end)

    pcall(function()
        if getgenv then getgenv().identifyexecutor = nil end
    end)

    print("[Nebula Hub] Parte 1 cargada correctamente.")
end

pcall(LoadNebulaHubPart1)
-- NEBULA HUB | Block Spin (Parte 2 / 2)
local function LoadNebulaHubPart2()
    local Players = game:GetService("Players")
    local CurrentCamera = workspace.CurrentCamera
    local LocalPlayer = Players.LocalPlayer
    local CoreGui = game:GetService("CoreGui")

    local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
    if not WindUI then return end

    local Window = WindUI:CreateWindow({
        Icon = "rbxassetid://74826351036046",
        Title = "NEBULA HUB | Block Spin",
        Author = "by Nebula.lua",
        Folder = "nebula's",
        Size = UDim2.fromOffset(480, 360),
        Transparent = true,
        Theme = "Dark",
        OpenButton = { Enabled = false }
    })

    if CoreGui:FindFirstChild("NebulaHubButton") then
        CoreGui.NebulaHubButton:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "NebulaHubButton"
    ScreenGui.IgnoreGuiInset = true

    local ImageButton = Instance.new("ImageButton", ScreenGui)
    ImageButton.BackgroundColor3 = Color3.fromRGB(12, 14, 22)
    ImageButton.Position = UDim2.new(0.5, -22, 0, 10)
    ImageButton.Size = UDim2.new(0, 45, 0, 45)
    ImageButton.Image = "rbxassetid://74826351036046"
    Instance.new("UICorner", ImageButton).CornerRadius = UDim.new(0, 8)

    local isOpen = true
    ImageButton.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then Window:Open() else Window:Close() end
    end)

    local CombatTab = Window:Tab({ Title = "COMBAT", Icon = "swords" })
    CombatTab:Section({ Title = "GUN / AIMBOT" })

    _G.SilentAimEnabled = false
    _G.SilentAimFOV = 120
    _G.AimPechoEnabled = false

    CombatTab:Toggle({
        Title = "Silent Aim / Aimbot",
        Flag = "silent_aim",
        Icon = "crosshair",
        Type = "Checkbox",
        Value = false,
        Callback = function(v) _G.SilentAimEnabled = v end
    })

    CombatTab:Toggle({
        Title = "AIM PECHO",
        Flag = "aim_pecho",
        Icon = "check",
        Type = "Checkbox",
        Value = false,
        Callback = function(v) _G.AimPechoEnabled = v end
    })

    CombatTab:Slider({
        Title = "FOV Aimbot",
        Flag = "gun_fov",
        Step = 1,
        Value = { Min = 50, Max = 500, Default = 120 },
        Callback = function(v) _G.SilentAimFOV = v end
    })

    print("[Nebula Hub] Parte 2 cargada con éxito.")
end

pcall(LoadNebulaHubPart2)
