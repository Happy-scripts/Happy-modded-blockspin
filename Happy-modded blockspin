-- Bajar debajo del suelo
local bajoAct = false, prof = 70
Main:Toggle({Title = "Bajo El Suelo", Flag = "bajo", Callback = function(v) bajoAct = v end})
Main:Slider({Title = "Profundidad", Flag = "prof", Min = 10, Max = 100, Default = 70, Callback = function(v) prof = v end})
RunService.Heartbeat:Connect(function()
    if bajoAct and RootPart then
        RootPart.CFrame *= CFrame.new(0, -prof/20, 0)
    end
end)

-- Recolectar
local recAct = false
Main:Toggle({Title = "Recolectar Todo", Flag = "reco", Callback = function(v) recAct = v end})
loop(0.3, function()
    if not recAct or not RootPart then return end
    local Cajas = workspace:FindFirstChild("DroppedItems")
    if not Cajas then return end
    for _, item in ipairs(Cajas:GetChildren()) do
        if item:GetAttribute("Locked") then continue end
        local p = item:FindFirstChild("PickUpZone") or item:FindFirstChildWhichIsA("BasePart", true)
        if p then
            local d = (p.Position - RootPart.Position).Magnitude
            if d < 55 then
                pcall(function() Net.get("pickup_dropped_item", item) end)
                if d > 6 then
                    RootPart.CFrame = CFrame.new(p.Position + Vector3.new(0, 2, 0))
                end
            end
        end
    end
end)

