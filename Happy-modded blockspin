task.spawn(function()
    local LP, Cam = LocalPlayer, workspace.CurrentCamera
    local fovDrawing = safeDrawingNew("Circle")
    if fovDrawing then
        fovDrawing.Color = Color3.fromRGB(0, 229, 255)
        fovDrawing.Thickness = 2
        fovDrawing.NumSides = 64
        fovDrawing.Filled = false
        fovDrawing.Visible = false
    end

    local function closest()
        local best, short = nil, math.huge
        local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
        local FOV = _G.SilentAimFOV or 120
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local root = p.Character.HumanoidRootPart
                    local sp, on = Cam:WorldToViewportPoint(root.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d <= FOV and d < short then
                            short = d
                            best = p
                        end
                    end
                end
            end
        end
        return best
    end

    local send = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Send")
    local old
    old = hookfunction(send.FireServer, function(self, ...)
        local args = {...}
        if _G.SilentAimEnabled and args[2] == "shoot_gun" then
            local t = closest()
            if t and t.Character then
                local head = t.Character:FindFirstChild("Head") or t.Character:FindFirstChild("HumanoidRootPart")
                if head then
                    args[4] = CFrame.lookAt(Cam.CFrame.Position, head.Position)
                    args[5] = {{{
                        Instance = head,
                        Normal = Vector3.new(0, 1, 0),
                        Position = head.Position,
                        Material = Enum.Material.Plastic,
                        Distance = 10
                    }}}
                end
            end
        end
        return old(self, unpack(args))
    end)

    RunService.RenderStepped:Connect(function()
        local show = _G.SilentAimEnabled and _G.ShowFOVCircle
        if fovDrawing then
            fovDrawing.Visible = show
            if show then
                fovDrawing.Position = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
                fovDrawing.Radius = _G.SilentAimFOV or 120
            end
        end
    end)
end)

