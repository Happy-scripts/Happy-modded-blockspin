-- NEBULA HUB | Block Spin - PARTE 1
if not game:IsLoaded() then
    repeat task.wait() until game:IsLoaded()
end

if not (game.PlaceId == 104715542330896 or game.PlaceId == 97556409405464) then
    return
end

local function LoadNebulaHubPart1()
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local TransitionModule = require(RS.Modules.Game.UI.TransitionUI)
        local old_transition = TransitionModule.transition
        TransitionModule.transition = function(p_in, p_wait, p_out, noLogo)
            if old_transition then return old_transition(p_in, p_wait, p_out, noLogo) end
        end
    end)

    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local CharCreator = require(RS.Modules.Game.CharacterCreator.CharacterCreator)
        if CharCreator.start then
            CharCreator.start = function(...) while true do task.wait(1) end end
        end
    end)

    pcall(function()
        if getgenv then getgenv().identifyexecutor = nil end
    end)

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local UserInputService = game:GetService("UserInputService")
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local CoreGui = game:GetService("CoreGui")

    local LocalPlayer = Players.LocalPlayer
    local Client = LocalPlayer
    local PlayerGui = Client:WaitForChild("PlayerGui")
    local Net = require(ReplicatedStorage.Modules.Core.Net)
    local SprintModule = require(ReplicatedStorage.Modules.Game.Sprint)
    local RagdollModule = require(ReplicatedStorage.Modules.Game.Ragdoll)
    local CharModule = require(ReplicatedStorage.Modules.Core.Char)

    local Character = Client.Character or Client.CharacterAdded:Wait()
    local Humanoid = Character:WaitForChild("Humanoid")
    local RootPart = Character:WaitForChild("HumanoidRootPart")

    Client.CharacterAdded:Connect(function(newCharacter)
        Character = newCharacter
        Humanoid = Character:WaitForChild("Humanoid")
        RootPart = Character:WaitForChild("HumanoidRootPart")
    end)

    local function permanentLoop(interval, fn)
        task.spawn(function()
            local waitTime = interval or 0.25
            while true do
                local ok = pcall(fn)
                if not ok then task.wait(math.max(waitTime, 0.35)) else task.wait(waitTime) end
            end
        end)
    end

    local function safeHttpGet(url)
        local ok, res = pcall(function()
            if game.HttpGet then return game:HttpGet(url) end
            return game:HttpGetAsync(url)
        end)
        if ok then return res end
        return nil
    end

    local function safeLoadUrl(url)
        local src = safeHttpGet(url)
        if not src then return nil end
        local ok, fn = pcall(loadstring, src)
        if ok and fn then
            local ok2, result = pcall(fn)
            if ok2 then return result end
        end
        return nil
    end

    local WindUI = safeLoadUrl("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua")
    if not WindUI then return end

    getgenv().NebulaWindow = WindUI:CreateWindow({
        Icon = "rbxassetid://74826351036046",
        IconThemed = true,
        Title = "NEBULA HUB | Block Spin",
        Author = "by Nebula.lua",
        Folder = "nebula's",
        Size = UDim2.fromOffset(480, 360),
        MinSize = Vector2.new(400, 300),
        MaxSize = Vector2.new(700, 520),
        Transparent = true,
        Theme = "Dark",
        Resizable = true,
        SideBarWidth = 165,
        BackgroundImageTransparency = 0.55,
        HideSearchBar = false,
        ScrollBarEnabled = false,
        OpenButton = { Enabled = false }
    })

    -- Botón Flotante
    if CoreGui:FindFirstChild("NebulaHubButton") then CoreGui.NebulaHubButton:Destroy() end
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NebulaHubButton"
    ScreenGui.Parent = CoreGui
    ScreenGui.IgnoreGuiInset = true

    local ImageButton = Instance.new("ImageButton")
    ImageButton.Parent = ScreenGui
    ImageButton.BackgroundColor3 = Color3.fromRGB(12, 14, 22)
    ImageButton.BorderSizePixel = 0
    ImageButton.Position = UDim2.new(0.5, -22, 0, 10)
    ImageButton.Size = UDim2.new(0, 45, 0, 45)
    ImageButton.Image = "rbxassetid://74826351036046"
    ImageButton.ScaleType = Enum.ScaleType.Fit

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = ImageButton

    local isOpen = true
    ImageButton.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then getgenv().NebulaWindow:Open() else getgenv().NebulaWindow:Close() end
    end)

    -- Pestaña General
    local MainTab = getgenv().NebulaWindow:Tab({ Title = "GENERAL", Icon = "globe" })
    MainTab:Section({ Title = "Player Modifier:" })

    local SpeedAmount = 35
    local EnabledSpeed = false
    permanentLoop(0.25, function()
        if EnabledSpeed and Humanoid and Humanoid.Parent then
            Net.send("set_sprinting_1", true)
            Humanoid.WalkSpeed = SpeedAmount
        end
    end)

    MainTab:Toggle({
        Title = "Walk Speed",
        Flag = "Walk Speed",
        Icon = "check",
        Type = "Checkbox",
        Value = false,
        Callback = function(Value)
            EnabledSpeed = Value
            if not Value and Humanoid and Humanoid.Parent then
                Humanoid.WalkSpeed = 16
                Net.send("set_sprinting_1", false)
            end
        end
    })

    MainTab:Slider({
        Title = "Speed Value",
        Flag = "speed_value",
        Step = 1,
        Value = { Min = 8, Max = 45, Default = SpeedAmount },
        Callback = function(Value) SpeedAmount = Value if Humanoid and EnabledSpeed then Humanoid.WalkSpeed = Value end end
    })

    -- Pestaña Combat
    local CombatTab = getgenv().NebulaWindow:Tab({ Title = "COMBAT", Icon = "swords" })
    CombatTab:Section({ Title = "GUN" })
    
    _G.SilentAimEnabled = false
    _G.SilentAimFOV = 120
    _G.AimMoreSafeEnabled = false
    _G.AimPechoEnabled = false

    CombatTab:Toggle({ Title = "Silent Aim", Flag = "silent_aim", Icon = "crosshair", Type = "Checkbox", Value = false, Callback = function(v) _G.SilentAimEnabled = v end })
    CombatTab:Toggle({ Title = "AIM MORE SAFE", Flag = "aim_more_safe", Icon = "check", Type = "Checkbox", Value = false, Desc = "2 primeros pecho → resto cabeza", Callback = function(v) _G.AimMoreSafeEnabled = v end })
    CombatTab:Toggle({ Title = "AIM PECHO", Flag = "aim_pecho", Icon = "check", Type = "Checkbox", Value = false, Desc = "Todas las balas al pecho", Callback = function(v) _G.AimPechoEnabled = v end })
    CombatTab:Slider({ Title = "FOV", Flag = "gun_fov", Step = 1, Value = { Min = 50, Max = 500, Default = 120 }, Callback = function(v) _G.SilentAimFOV = v end })

    print("[NebulaHub] Parte 1 cargada con éxito.")
end

pcall(LoadNebulaHubPart1)
-- NEBULA HUB | Block Spin - PARTE 2
local function LoadNebulaHubPart2()
    local Window = getgenv().NebulaWindow
    if not Window then return end

    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    -- Pestaña Farm
    local FarmTab = Window:Tab({ Title = "FARM", Icon = "package" })
    FarmTab:Section({ Title = "Minigames:" })
    
    local AutoMinigame = false
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local SliderModule
    pcall(function()
        SliderModule = require(ReplicatedStorage.Modules.Game.Minigames.SliderMinigame)
    end)

    task.spawn(function()
        while true do
            task.wait(0.1)
            if AutoMinigame then
                pcall(function()
                    if SliderModule and SliderModule.enabled and SliderModule.enabled.get() then
                        local target = SliderModule.target_pos.get()
                        SliderModule.needle_pos.set(target)
                        local cam = workspace.CurrentCamera
                        local cx, cy = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
                        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                        task.wait(0.03)
                        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                    end
                end)
            end
        end
    end)

    FarmTab:Toggle({
        Title = "Auto Minigame",
        Flag = "auto_minigame",
        Desc = "Automatiza los minijuegos de slider",
        Icon = "check",
        Type = "Checkbox",
        Value = false,
        Callback = function(Value) AutoMinigame = Value end
    })

    -- Pestaña Shop
    local ShopTab = Window:Tab({ Title = "SHOP", Icon = "shopping-cart" })
    ShopTab:Section({ Title = "AMMO CRATES" })
    ShopTab:Button({
        Title = "📦 Buy Pistol Ammo",
        Callback = function()
            pcall(function() Net.get("open_crate", workspace.Map.Tiles.GunShopTile.PatriotWeapons.Interior.Crates["Ammo Crate"].CrateOptions.Pistol, "money") end)
        end
    })

    -- Pestaña Vehicle
    local VehicleTab = Window:Tab({ Title = "VEHICLE", Icon = "car" })
    VehicleTab:Section({ Title = "VEHICLES" })
    VehicleTab:Button({
        Title = "🚗 Car Fly / Speed Fix",
        Callback = function() end
    })

    -- Pestaña Visual
    local VisualTab = Window:Tab({ Title = "VISUAL", Icon = "eye" })
    VisualTab:Section({ Title = "Players:" })

    _G.GreenESP_Enabled = true
    VisualTab:Toggle({
        Title = "Green ESP",
        Flag = "green_esp",
        Desc = "Green body hologram",
        Icon = "check",
        Type = "Checkbox",
        Default = true,
        Callback = function(Value) _G.GreenESP_Enabled = Value end
    })

    task.spawn(function()
        local highlights = {}
        RunService.Heartbeat:Connect(function()
            if not _G.GreenESP_Enabled then
                for _, hl in pairs(highlights) do if hl then hl:Destroy() end end
                highlights = {}
                return
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local char = plr.Character
                    if not highlights[plr] or highlights[plr].Parent ~= char then
                        if highlights[plr] then highlights[plr]:Destroy() end
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(0, 255, 70)
                        hl.OutlineColor = Color3.fromRGB(180, 255, 180)
                        hl.FillTransparency = 0.32
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char
                        highlights[plr] = hl
                    end
                end
            end
        end)
    end)

    -- Pestaña Misc
    local MiscTab = Window:Tab({ Title = "MISC", Icon = "circle-ellipsis" })
    MiscTab:Section({ Title = "Extra Tools" })
    MiscTab:Button({
        Title = "🚀 Boost FPS",
        Callback = function()
            pcall(function() loadstring(game:HttpGet("https://pastefy.app/Pmu7jqMe/raw"))() end)
        end
    })

    -- Pestaña Spectate
    local SpectateTab = Window:Tab({ Title = "SPECTATE", Icon = "eye" })
    SpectateTab:Section({ Title = "Spectate Players" })

    -- Pestaña Server
    local ServerTab = Window:Tab({ Title = "SERVER", Icon = "server" })
    ServerTab:Section({ Title = "Server Control" })
    ServerTab:Button({
        Title = "🔄 Server Hop",
        Callback = function()
            local TS = game:GetService("TeleportService")
            TS:Teleport(game.PlaceId, LocalPlayer)
        end
    })

    -- Pestaña Config
    local ConfigTab = Window:Tab({ Title = "CONFIG", Icon = "settings" })
    ConfigTab:Section({ Title = "Settings" })

    Window:Open()
    print("[NebulaHub] Parte 2 cargada con éxito. ¡Todo listo!")
end

pcall(LoadNebulaHubPart2)
