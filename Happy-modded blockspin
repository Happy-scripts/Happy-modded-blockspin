local function checkHackerStatus(player)
	if not player.Character or player == LocalPlayer then return false end
	local hrp = player.Character:FindFirstChild("HumanoidRootPart")
	local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then return false end

	local currentTime = tick()
	local deltaTime = currentTime - (lastTimes[player] or currentTime)
	local currentPos = hrp.Position
	local lastPos = lastPositions[player] or currentPos

	lastPositions[player] = currentPos
	lastTimes[player] = currentTime

	if deltaTime <= 0 then return false end

	local horizontalDistance = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude
	local realSpeed = horizontalDistance / deltaTime
	local verticalVelocity = math.abs(hrp.AssemblyLinearVelocity.Y)

	if realSpeed > 42 or (verticalVelocity > 80 and not hrp:FindFirstChildOfClass("BodyVelocity")) then
		return true
	end
	return false
end

